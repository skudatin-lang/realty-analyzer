{
  "$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,
  "required":["id","role","address","price","area","rooms","property","building","location","condition","contents","legal","transaction","observations","seller_claims","needs_verification","contradictions","missing_important_fields","photo_analysis"],
  "properties":{
    "id":{"type":"string"},"role":{"enum":["target","competitor"]},"address":{"type":["string","null"]},"price":{"type":["number","null"],"minimum":0},"area":{"type":["number","null"],"minimum":0},"price_per_m2_claimed":{"type":["number","null"],"minimum":0},"rooms":{"type":["number","string","null"]},
    "property":{"$ref":"#/$defs/category"},"building":{"$ref":"#/$defs/category"},"location":{"$ref":"#/$defs/category"},"condition":{"$ref":"#/$defs/category"},"contents":{"$ref":"#/$defs/category"},"legal":{"$ref":"#/$defs/category"},"transaction":{"$ref":"#/$defs/category"},
    "observations":{"type":"array","items":{"$ref":"#/$defs/evidence"}},"seller_claims":{"type":"array","items":{"$ref":"#/$defs/evidence"}},"needs_verification":{"type":"array","items":{"$ref":"#/$defs/evidence"}},"contradictions":{"type":"array","items":{"$ref":"#/$defs/contradiction"}},"missing_important_fields":{"type":"array","items":{"type":"string"}},"photo_analysis":{"$ref":"#/$defs/photo_analysis"}
  },
  "$defs":{
    "source":{"enum":["ИЗОБРАЖЕНИЕ","ТЕКСТ","ОБА ИСТОЧНИКА","РАСЧЁТ"]},"evidence_status":{"enum":["ФАКТ","ЗАЯВЛЕНО ПРОДАВЦОМ","НЕИЗВЕСТНО","НУЖНО ПРОВЕРИТЬ"]},
    "evidence":{"type":"object","additionalProperties":false,"required":["field","value","source","note","status","source_text"],"properties":{"field":{"type":"string"},"value":{"type":["string","number","boolean","null"]},"source":{"$ref":"#/$defs/source"},"note":{"type":"string"},"status":{"$ref":"#/$defs/evidence_status"},"source_text":{"type":"string"}}},
    "category":{"type":"array","items":{"$ref":"#/$defs/evidence"}},
    "contradiction":{"type":"object","additionalProperties":false,"required":["field","image_value","text_value","resolution"],"properties":{"field":{"type":"string"},"image_value":{"type":["string","number","boolean","null"]},"text_value":{"type":["string","number","boolean","null"]},"resolution":{"enum":["СПРОСИТЬ ПО ТЕЛЕФОНУ","ПРОВЕРИТЬ НА ПРОСМОТРЕ","ПРОВЕРИТЬ ДОКУМЕНТЫ"]}}},
    "photo_item":{"type":"object","additionalProperties":false,"required":["observation","interpretation","status"],"properties":{"observation":{"type":"string"},"interpretation":{"type":"string"},"status":{"enum":["ФАКТ","ГИПОТЕЗА","НУЖНО ПРОВЕРИТЬ"]}}},
    "photo_analysis":{"type":"object","additionalProperties":false,"required":["has_images","observations","presentation_strengths","presentation_weaknesses","text_photo_gaps"],"properties":{"has_images":{"type":"boolean"},"observations":{"type":"array","items":{"$ref":"#/$defs/photo_item"}},"presentation_strengths":{"type":"array","items":{"$ref":"#/$defs/photo_item"}},"presentation_weaknesses":{"type":"array","items":{"$ref":"#/$defs/photo_item"}},"text_photo_gaps":{"type":"array","items":{"$ref":"#/$defs/photo_item"}}}}
  }
}
